{
  "name": "jarvisprimez", "version": "1.2.0", "description": "JarvisPrimez AI Voice Assistant",
  "author": "Amitanshu", "main": "main.js",
  "scripts": { "start": "electron .", "dist": "electron-builder --win nsis" },
  "devDependencies": { "electron": "^33.0.0", "electron-builder": "^25.1.8" },
  "build": {
    "appId": "com.amitanshu.jarvisprimez", "productName": "JarvisPrimez",
    "files": ["main.js", "index.html"],
    "directories": { "buildResources": "build", "output": "dist" },
    "win": { "target": "nsis", "icon": "build/icon.ico" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true, "createStartMenuShortcut": true,
      "installerIcon": "build/icon.ico", "uninstallerIcon": "build/icon.ico",
      "shortcutName": "JarvisPrimez", "artifactName": "JarvisPrimez-Setup.exe" }
  }
}
